# Optional — only needed to enable the Tier 3 Gemini Vision fallback in
# /semantic. The visual matcher (/match) and Tiers 1-2 of /semantic work
# with zero API keys, pure OpenCV + Tesseract.
GOOGLE_API_KEY=

# Port the server listens on (default 8001, matches the original FEU-COMPASS
# integration so it's a drop-in replacement if you ever wire this back up
# to a Laravel front end).
PORT=8001
